    <div id="si-sp" class="sp" style=""><div id="gradient" data-bid="gradient" class="sb sib-gradient" style="height: 11px;"><div class="ss-s ss-bg"><div class="sc" style="width:1200px"><div data-sid="gradient_0" class="sie-gradient_0 se" style="width: 1728px; transform: scale(1, 1) translate(-264px);"><div class="se-simple"></div></div><div data-sid="gradient_1" class="sie-gradient_1 se" style="width: 1728px; transform: scale(1, 1) translate(-264px);"><div class="se-simple"></div></div><div data-sid="gradient_2" class="sie-gradient_2 se" style="width: 1728px; transform: scale(1, 1) translate(-264px);"><div class="se-simple"></div></div></div></div></div><div id="intro" data-bid="intro" class="sb sib-intro" style="height: 852px;"><div class="ss-s ss-bg"><div class="sc" style="width:1200px"><div data-sid="intro_0" class="sie-intro_0 se" style="width: 1529px; transform: scale(1, 1) translate(-264px);"><div style="width: 100%; height: 100%; position: absolute; top: 0px; left: 0px; background-image: url(&quot;//static.showit.co/2400/BiQC1os-TmC-jYMvNn8rTQ/135776/aq4a5246-2.jpg&quot;);" data-img="intro_0" class="se-img se-gr slzy"></div></div><div data-sid="intro_1" class="sie-intro_1 se" style="display: none;"><div data-sie="intro_1" class="sg-s sig-intro_1 sg-sc-2 se-gallery-queued" style="width:100%;height:100%"><div style="width:100%;height:100%;background-image:url(//static.showit.co/1200/BiQC1os-TmC-jYMvNn8rTQ/135776/aq4a5246-2.jpg)" class="se-img"></div></div><div></div></div><div data-sid="intro_2" class="sie-intro_2 se" style="transform: scale(1, 1) translate(-264px);"><div class="se-simple"></div></div><div data-sid="intro_3" class="sie-intro_3 se" style="transform: scale(1, 1) translate(-264px);"><div style="width: 100%; height: 100%; position: absolute; top: 0px; left: 0px; background-image: url(&quot;//static.showit.co/file/arMf6eZ8RNu9o9MUBGuS1g/shared/mia_o_malley_plus_size_education_and_empowerment_fat_positive_plus_size_maternity_inspiration_babywearing_body_positive_parenting_blogger_blogging_blog_content_creator16.svg&quot;);" data-img="intro_3" class="se-img se-gr slzy"></div></div><div data-sid="intro_4" class="sie-intro_4 se" style="transform: scale(1, 1) translate(-264px);"><h2 class="se-t sie-intro_4-text st-m-title st-d-title se-rc">Let's work to<br>build a world that accommodates all bodies.</h2></div><div data-sid="intro_5" class="sie-intro_5 se" style="transform: scale(1, 1) translate(-264px);"><h2 class="se-t sie-intro_5-text st-m-heading st-d-heading se-rc">An all-new Mia O'Malley <br>is arriving soon</h2></div><div data-sid="intro_6" class="sie-intro_6 se" style="transform: scale(1, 1) translate(-264px);"><div class="se-simple"></div></div><div data-sid="intro_7" class="sie-intro_7 se" style="transform: scale(1, 1) translate(264px);"><div style="width: 100%; height: 100%; position: absolute; top: 0px; left: 0px; background-image: url(&quot;//static.showit.co/file/QuBNh1NGS4qYvqIiEfzWNw/shared/logo-06.svg&quot;);" data-img="intro_7" class="se-img se-gr slzy"></div></div><div data-sid="intro_8" class="sie-intro_8 se se-pc" style="transform: scale(1, 1) translate(264px); cursor: pointer;"><div class="se-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512"><path d="M461.49,248.51,394,181a12,12,0,0,0-17,17l46.52,46.51H60a12,12,0,0,0,0,24H424.53L377,316a12,12,0,0,0,17,17l67.5-67.5A12,12,0,0,0,461.49,248.51Z"></path></svg></div></div><a href="mailto:mia.omalley@gmail.com" target="_self" class="sie-intro_9 se se-bd se-bm" data-sid="intro_9" style="transform: scale(1, 1) translate(-264px);"><div class="se-simple"></div></a><a href="mailto:mia.omalley@gmail.com" target="_self" class="sie-intro_10 se" data-sid="intro_10" style="transform: scale(1, 1) translate(-264px);"><h2 class="se-t sie-intro_10-text st-m-heading st-d-heading">CONTACT MIA VIA EMAIL</h2></a><a href="https://www.tiktok.com/@plussizebabywearing" target="_blank" class="sie-intro_11 se" data-sid="intro_11" style="transform: scale(1,